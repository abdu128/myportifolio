# EmailJS Configuration
# Get these values from your EmailJS dashboard at https://www.emailjs.com/

# Service ID (from Email Services section)
VITE_EMAILJS_SERVICE_ID=service_abc123

# Template ID (from Email Templates section)  
VITE_EMAILJS_TEMPLATE_ID=template_xyz789

# Public Key (from Account > API Keys section)
VITE_EMAILJS_PUBLIC_KEY=user_public_key_here

# Instructions:
# 1. Copy this file and rename it to .env
# 2. Replace the placeholder values with your actual EmailJS credentials
# 3. Restart your development server 